# AIHOTNESS Configuration

# DeepSeek API Key (get one at https://platform.deepseek.com)
# Leave empty to run in "Cold Mode" (no LLM classification/summary)
DEEPSEEK_API_KEY=

# Collection interval in minutes (default: 15)
COLLECTION_INTERVAL=15

# Max articles to collect per source per run (default: 20)
MAX_ARTICLES_PER_SOURCE=20

# Article retention in days (default: 30)
ARTICLE_RETENTION_DAYS=30

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
